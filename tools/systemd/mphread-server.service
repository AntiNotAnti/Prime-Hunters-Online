# The game server people join. It runs the match, needs the game files, and
# records bounded canonical replays by default.
#
# __USER__ and __DIR__ are placeholders: deploy-server.sh fills them in when
# it installs this. By hand:
#
#   sed -e 's|__USER__|livetek|' -e 's|__DIR__|/home/livetek/mphread-server|' \
#       tools/systemd/mphread-server.service | sudo tee /etc/systemd/system/mphread-server.service
#   sudo systemctl enable --now mphread-server
[Unit]
Description=Project Prime dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
# Optional private Hunter License reporter credential.
EnvironmentFile=-__DIR__/career.env
# -servername is what players see in the launcher's server browser. The server
# lists itself on 51.161.113.128 so that it can be found there; add -nomaster
# to keep it private, or -master HOST to use a different directory.
ExecStart=__DIR__/ProjectPrime -server -port 27888 -players 8 -servername "Project Prime"
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
